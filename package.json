{
  "name": "chengxu-theme-template",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "tokens:build": "node packages/design-tokens/scripts/build.mjs",
    "tokens:check": "node packages/design-tokens/scripts/build.mjs --check",
    "dev": "pnpm tokens:build && pnpm --filter @template/web dev",
    "build": "pnpm tokens:build && pnpm --filter @template/web build",
    "lint": "pnpm --filter @template/web lint",
    "typecheck": "pnpm --filter @template/web typecheck",
    "test:themes": "node --test packages/design-tokens/tests/themes.test.mjs"
  }
}
